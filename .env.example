# Copy to .env and fill in. Never commit the real .env file.

# Webhook security (App Dashboard)
META_VERIFY_TOKEN=pick-any-long-random-string
META_APP_SECRET=your_meta_app_secret          # App settings > Basic; signs WhatsApp webhooks
INSTAGRAM_APP_SECRET=                         # Instagram > API setup with Instagram login; blank = use META_APP_SECRET

# Instagram (Instagram API with Instagram Login)
INSTAGRAM_ACCOUNT_ID=17841400000000000        # your professional account's ID
INSTAGRAM_ACCESS_TOKEN=

# WhatsApp Cloud API (WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=                     # optional, comma-separated, e.g. 15550001111; blank = anyone

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Behaviour
GRAPH_API_VERSION=v26.0
BUSINESS_PROFILE_PATH=samples/business_profile.example.md
REPLY_TO_COMMENTS=true
DRY_RUN=false
PER_USER_HOURLY_LIMIT=5
DAILY_REPLY_CAP=200
HUMAN_TAKEOVER_HOURS=24
# HANDOVER_KEYWORDS=human,agent,manager,complaint,refund,cancel
# CRISIS_KEYWORDS=suicide,self harm,emergency
PORT=8000
